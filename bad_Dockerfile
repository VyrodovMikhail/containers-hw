# Не указываем конкретную версию питона
FROM python:latest
WORKDIR /app

# Делаем RUN в несколько строк -> создание нескольких слоев -> увеличение размера docker образа
RUN apt-get update

# Установка python, хотя он есть в базовом образе
RUN apt-get install -y curl

# Заносим все изменения проекта до того, как устанавливаем зависимости
# Поэтому зависимости будут переустанавливаться на любое изменение в файлах проекта
COPY . .

# Нет аргумента --no-cache-dir, поэтому памяти тратим больше
RUN pip install -r requirements.txt

# Вместо .env файла прям в докерфайле экспоузим апи ключ
ENV LLM_API_KEY="12345"

EXPOSE 5000

VOLUME /app/data

CMD  ["python", "app.py", "--output-dir", "/app/data"]